# Copy this file to .env and fill in real values for local development.

# Postgres connection string. Matches the docker-compose service below by default.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/pa_board_dev"

# Secret used to sign auth JWTs. Use a long random value in real environments.
JWT_SECRET="change-me-to-a-long-random-string"

# Port the API listens on.
PORT=4000

# Comma-separated list of origins allowed to call the API (the Expo app's dev origin, etc).
CORS_ORIGIN="*"

# Claude API key for the conversation engine (see services/conversationEngine.ts).
# Resolved by the SDK from the environment - get one at https://console.anthropic.com
ANTHROPIC_API_KEY=""

# WhatsApp Cloud API (Meta) - see https://developers.facebook.com/docs/whatsapp/cloud-api
# All optional: the server boots without them, but the WhatsApp channel won't work.
WHATSAPP_ACCESS_TOKEN=""
WHATSAPP_PHONE_NUMBER_ID=""
# Any string you choose - enter the same value when registering the webhook URL in the Meta App Dashboard.
WHATSAPP_VERIFY_TOKEN=""
# App secret from the Meta App Dashboard, used to verify webhook signatures.
WHATSAPP_APP_SECRET=""

# How often the reminder scheduler checks for due reminders, in milliseconds.
REMINDER_POLL_INTERVAL_MS=30000

# Where voice notes and spoken replies are stored (relative to the backend dir).
STORAGE_DIR="storage"

# Voice pipeline (spec section 5). Both optional - without them, voice notes get
# a text apology and replies stay text.
# Speech-to-text: OpenAI Whisper - https://platform.openai.com
OPENAI_API_KEY=""
# Text-to-speech: ElevenLabs - https://elevenlabs.io. eleven_v3 covers Hebrew;
# eleven_multilingual_v2 is cheaper but English-and-friends only.
ELEVENLABS_API_KEY=""
ELEVENLABS_VOICE_ID="21m00Tcm4TlvDq8ikWAM"
ELEVENLABS_MODEL_ID="eleven_v3"

# Google OAuth for Gmail + Calendar (spec section 6). Create a Web application
# OAuth client at https://console.cloud.google.com/apis/credentials, enable the
# Gmail API and Google Calendar API, and add GOOGLE_REDIRECT_URI as an
# authorized redirect URI. The redirect must be reachable from the user's
# browser (a public URL / tunnel in real use).
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_REDIRECT_URI="http://localhost:4000/oauth/google/callback"
