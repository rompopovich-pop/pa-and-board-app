# Copy to .env for local development. Expo inlines EXPO_PUBLIC_* vars at build time.

# Backend API URL. "localhost" only works from a simulator/emulator on the
# same machine as the API — on a physical device, use your machine's LAN IP.
EXPO_PUBLIC_API_URL="http://localhost:4000"

# Your WhatsApp Business number (digits only, no "+"), for the "Chat on
# WhatsApp" link in Settings. Leave unset to hide that button.
EXPO_PUBLIC_WHATSAPP_NUMBER=""
